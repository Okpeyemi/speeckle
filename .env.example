# ============================================================
# Speeckle — Variables d'environnement
# Copie ce fichier en .env.local et remplis les valeurs
# ============================================================

# ── ASR Model ──────────────────────────────────────────────
# ID du modèle ASR sur HuggingFace Hub
ASR_MODEL_ID=ton-org/ton-modele-asr-fon

# URL de l'endpoint ASR (si tu mets seulement l'hote, /transcribe est ajoute automatiquement)
ASR_API_URL=https://asr.pscl.space/transcribe

# Optionnel: liste d'URLs ASR separees par des virgules (tentative dans l'ordre)
# ASR_API_URLS=https://tts.pcsl.space/transcribe,http://127.0.0.1:8000/transcribe

# Timeout d'appel ASR en millisecondes (0 pour desactiver)
ASR_FETCH_TIMEOUT_MS=120000

# Active le fallback local implicite vers 127.0.0.1/localhost si true
ASR_ENABLE_LOCAL_FALLBACK=false

# ── General Model ──────────────────────────────────────────
# URL de l'API du modèle Général (FastAPI, etc.)
GENERAL_MODEL_URL=http://localhost:8001

# ── TTS Model ──────────────────────────────────────────────
# ID du modèle TTS sur HuggingFace Hub
TTS_MODEL_ID=ton-org/ton-modele-tts-fon

# URL de l'API TTS si hébergée en interne
TTS_API_URL=https://tts.pcsl.space/synthesize

# ── HuggingFace ────────────────────────────────────────────
# Token d'accès HuggingFace (pour les modèles privés ou l'Inference API)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL Inference Router Hugging Face (nouveau endpoint)
HF_INFERENCE_BASE_URL=https://router.huggingface.co/hf-inference/models

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Speeckle
NEXT_PUBLIC_APP_VERSION=0.1.0
